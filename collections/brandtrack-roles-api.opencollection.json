{
  "opencollection": "1.0.0",
  "info": {
    "name": "Brandtrack API Documentation Accounts Roles API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-customer-api-key",
      "value": "{{x-customer-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Roles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "api.brandtrack.fm/v2/roles",
            "headers": [
              {
                "name": "x-customer-api-key",
                "value": "{YOUR_AUTH_KEY}"
              }
            ]
          },
          "docs": "List all roles"
        }
      ]
    }
  ],
  "bundled": true
}